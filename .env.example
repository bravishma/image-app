# Copy to .env and fill in. .env is gitignored; this file is safe to commit.
WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/your-webhook-id

# Optional: matches "Header Auth" on the n8n Webhook node.
# WEBHOOK_AUTH_HEADER=X-Api-Key
# WEBHOOK_AUTH_VALUE=your-secret

PORT=8000
TIMEOUT_MS=60000
MAX_BODY_BYTES=22020096
RATE_MAX=12
RATE_WINDOW_MS=300000
